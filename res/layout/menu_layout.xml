<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎮 RAMDAEMON"
        android:textColor="@color/primary_green"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp"/>

    <!-- Khu vực Scan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        
        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/text_white"/>
            
        <EditText
            android:id="@+id/edtValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Value (VD: 100)"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:inputType="text"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Scan"
        android:textColor="@color/bg_dark"
        android:backgroundTint="@color/primary_green"/>
        
    <TextView
        android:id="@+id/tvOutput"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#0A0A0A"
        android:padding="8dp"
        android:textColor="@color/primary_green"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:scrollbars="vertical"
        android:layout_marginTop="8dp"
        android:text="Chưa có dữ liệu..."/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        
        <Button
            android:id="@+id/btnNextChanged"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="Next (Changed)"
            android:textSize="10sp"/>
            
        <Button
            android:id="@+id/btnResults"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="Results"
            android:textSize="10sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:text="Đóng Menu"
        android:backgroundTint="#FF5252"
        android:textColor="@color/text_white"/>
</LinearLayout>
