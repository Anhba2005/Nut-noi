<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/greeting"
            android:textColor="#1F2937"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/rootStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/root_status_checking"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/firewall_warning_short"
            android:textColor="#B91C1C"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <!-- Ô NHẬP LỆNH NÚT XANH -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/edit_block_commands"
            android:layout_marginBottom="12dp"
            app:hintTextColor="#4B5563"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/blockCommandsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="4"
                android:maxLines="8"
                android:scrollbars="vertical"
                android:textColor="#1F2937"
                android:textColorHint="#9CA3AF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ô NHẬP LỆNH NÚT ĐỎ -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/edit_unblock_commands"
            android:layout_marginBottom="12dp"
            app:hintTextColor="#4B5563"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/unblockCommandsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="4"
                android:maxLines="8"
                android:scrollbars="vertical"
                android:textColor="#1F2937"
                android:textColorHint="#9CA3AF" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSaveCommands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnToggleOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_button"
            android:textAllCaps="false"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/overlaySizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/overlaySizeSeekBar"
            android:text="@string/overlay_size_value_default"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <SeekBar
            android:id="@+id/overlaySizeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/overlay_size_label" />
    </LinearLayout>
</ScrollView>
