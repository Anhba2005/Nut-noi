<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/greeting"
            android:textColor="#1F2937"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/firewall_description"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnToggleOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_button"
            android:textAllCaps="false"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/overlaySizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/overlaySizeSeekBar"
            android:text="@string/overlay_size_value_default"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <SeekBar
            android:id="@+id/overlaySizeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/overlay_size_label" />
    </LinearLayout>
</ScrollView>
