<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chào Anh Ba"
            android:textColor="#212121"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRootStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Trạng thái root: Đang kiểm tra..."
            android:textColor="#616161"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Lệnh Shell khi nút XANH LÁ (Chạy ô này):"
            android:textColor="#2E7D32"
            android:textStyle="bold" />

        <!-- Đã ép màu chữ ĐEN (#000000) và nền TRẮNG TINH để luôn nhìn rõ -->
        <EditText
            android:id="@+id/edtCmdGreen"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:gravity="top|start"
            android:hint="Mời Nhập Shell (khi nút Xanh)..."
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Lệnh Shell khi nút ĐỎ (Chạy ô này):"
            android:textColor="#C62828"
            android:textStyle="bold" />

        <!-- Đã ép màu chữ ĐEN (#000000) và nền TRẮNG TINH để luôn nhìn rõ -->
        <EditText
            android:id="@+id/edtCmdRed"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:gravity="top|start"
            android:hint="Mời Nhập Shell (khi nút Đỏ)..."
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#1976D2"
            android:text="Lưu cấu hình"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnToggleFloating"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#1976D2"
            android:text="Bật nút nổi"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Kích thước nút nổi: 72 dp"
            android:textColor="#212121"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/sbSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="140"
            android:progress="72" />

    </LinearLayout>
</ScrollView>
